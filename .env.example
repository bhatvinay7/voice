# Environment variable reference for real-estate/estate.
# This file contains examples only. It is safe to version; actual .env files are not.
# Copy only the relevant settings into each server/service's own private .env.
# Supply real keys, passwords and connection credentials on that server, never here.
# Blank credentials are intentional and must be filled privately before deployment.
# Commented optional keys remain absent so the loader can use its fallback logic.
# Shared AppConfig::load requires several model/prompt/storage keys even when a
# service does not directly use that feature; blank examples are not deployable secrets.
# Model IDs and example URLs must be replaced/verified for your provider account.
#
# Local Compose currently layers root .env plus service files for the backend:
# crates/services/server/.env, crates/libs/orchestrator/.env, crates/libs/agent/.env.
# It uses root .env for control-plane/worker and root .env + apps/web/.env.local for web.
# Later env_file entries override earlier entries; explicit environment entries win.
# On separate servers, provide their configuration locally rather than copying secrets
# between repositories. Never expose backend credentials in NEXT_PUBLIC_* variables.


# ========================================================================
# Service runtime and deployment
# ========================================================================
# Backend HTTP listen port. For the web process, Next.js also uses PORT; keep separate service env files.
PORT=4000

# Reserved orchestrator port in shared config; the current backend embeds the orchestrator rather than binding this port.
ORCHESTRATOR_PORT=4001

# Reserved agent port in shared config; the current backend embeds the agent rather than binding this port.
AGENT_PORT=4002

# Runtime mode; set production on deployed services and the Next.js server.
NODE_ENV=development

# Backend gRPC connection to the control-plane; Compose overrides this with http://control-plane:50051.
CONTROL_PLANE_ENDPOINT=http://127.0.0.1:50051

# Control-plane gRPC listen port.
GRPC_PORT=50051

# Fallback for GRPC_PORT only when GRPC_PORT is absent.
# CONTROL_PLANE_PORT=50051

# Control-plane HTTP metrics listen port.
METRICS_PORT=9090

# Fallback for METRICS_PORT only when METRICS_PORT is absent.
# CONTROL_PLANE_METRICS_PORT=9090

# Backend cell identity registered with the control-plane; normally supplied by the host/container.
# HOSTNAME=voice-cell-1

# Maximum concurrent sessions enforced by this backend cell and advertised to control-plane instances.
MAX_SLOTS_PER_CELL=20

# Container image registry/namespace used by docker-compose.dev.yml.
REGISTRY=docker.io/your-organization

# Container image tag used by docker-compose.dev.yml.
TAG=latest

# ========================================================================
# Persistence and retrieval
# ========================================================================
# Redis connection for summary-job queues and short-lived cache entries.
REDIS_URL=redis://127.0.0.1:6379

# Required Neon pooled PostgreSQL connection string shared by backend, control-plane and worker.
# Use the hostname ending in `-pooler`; it is used by the SQLx connection pools.
NEON_POOLER_URL=

# Optional direct Neon connection string used only by migrations. If omitted, the
# migration runner uses NEON_POOLER_URL.
POSTGRES_DIRECT_URL=

# Legacy fallback used only when NEON_POOLER_URL is absent.
POSTGRES_URL=

# Fallback for POSTGRES_URL only when it is absent.
# DATABASE_URL=

# Upstash Vector REST endpoint used by retrieval; required by the shared config loader.
UPSTASH_VECTOR_REST_URL=

# Secret Upstash Vector REST authorization token.
UPSTASH_VECTOR_REST_TOKEN=

# Legacy fallback for UPSTASH_VECTOR_REST_URL; omit the canonical key to use this alias.
# UPSTASH_VECTOR_URL=

# Legacy fallback for UPSTASH_VECTOR_REST_TOKEN; omit the canonical key to use this alias.
# UPSTASH_VECTOR_TOKEN=

# Optional Neo4j/Memgraph graph endpoint; leave commented to use the existing in-memory graph fallback.
# NEO4J_URI=bolt://127.0.0.1:7687

# Optional graph database login paired with NEO4J_URI.
# NEO4J_USERNAME=

# Secret graph database password paired with NEO4J_URI.
# NEO4J_PASSWORD=

# Optional database name within Neo4j.
# NEO4J_DATABASE=neo4j

# Fallback graph endpoint when NEO4J_URI is absent.
# MEMGRAPH_URI=

# Fallback graph username when NEO4J_USERNAME is absent.
# MEMGRAPH_USERNAME=

# Secret fallback graph password when NEO4J_PASSWORD is absent.
# MEMGRAPH_PASSWORD=

# ========================================================================
# Authentication (backend secrets only)
# ========================================================================
# Administrator access is assigned through user_profiles.role = 'admin' in Neon.
# Authentication credentials are managed by the configured login provider, not this file.

# Secret signing key for application login tokens; generate a strong random value and share only with services verifying those tokens.
JWT_SECRET=

# Google OAuth client ID accepted by backend Google sign-in verification; must match the web client ID.
GOOGLE_CLIENT_ID=

# ========================================================================
# Browser voice (LiveKit)
# ========================================================================
# LiveKit server endpoint used for browser call rooms; phone calls bypass LiveKit.
LIVEKIT_URL=wss://your-project.example.com

# LiveKit server API key used to mint room access tokens; backend only.
LIVEKIT_API_KEY=

# Secret LiveKit signing credential; never place in NEXT_PUBLIC variables.
LIVEKIT_API_SECRET=

# ========================================================================
# Language model and decision model
# ========================================================================
# Provider label exposed by configuration; actual requests use LLM_ENDPOINT_URL and LLM_API_KEY.
LLM_PROVIDER=openai

# Secret credential used by the configured TTS client and as the default general LLM API key.
OPENAI_API_KEY=

# Optional secret for the main LLM endpoint; leave absent to fall back to AGENT_LLM_API_KEY, then OPENAI_API_KEY.
# LLM_API_KEY=

# Legacy secret fallback for LLM_API_KEY; normally leave commented.
# AGENT_LLM_API_KEY=

# OpenAI-compatible chat-completions endpoint for the agent/chat API.
LLM_ENDPOINT_URL=https://api.openai.com/v1/chat/completions

# Model ID accepted by the configured main LLM endpoint.
LLM_MODEL=replace-with-your-chat-model

# Legacy model fallback used only when LLM_MODEL is absent.
# AGENT_LLM_MODEL=

# Optional secret for the decision/reasoning endpoint; defaults to the resolved main LLM key when absent.
# DECISION_LLM_API_KEY=

# Optional decision-model endpoint; defaults to LLM_ENDPOINT_URL when absent.
# DECISION_LLM_ENDPOINT_URL=

# Model ID for agent decisions and tool reasoning; required by the config loader.
DECISION_LLM_MODEL=replace-with-your-decision-model

# Legacy fallback used only when DECISION_LLM_MODEL is absent.
# DECISION_MODEL=

# Low-latency OpenAI-compatible model used to rewrite RAG queries and make
# orchestration routing decisions. It is safe to point this at a smaller model.
FAST_MODEL_API_KEY=
FAST_MODEL_ENDPOINT_URL=
FAST_MODEL=

# Comma-separated business vocabulary supplied to the RAG query rewriter.
RAG_BUSINESS_KEYWORDS=

# Brief TTS acknowledgement played immediately before a potentially slow tool call.
TOOL_WAIT_TTS_PROMPT=
TOOL_RETRY_TTS_PROMPT=It's taking a little longer than expected. I'm still checking that for you.

# ========================================================================
# Speech recognition, synthesis and voice activity
# ========================================================================
# Configured STT provider label; the current speech pipelines send requests through GROQ_STT_URL using GROQ_API_KEY.
STT_PROVIDER=openai

# Secret speech-recognition credential sent to GROQ_STT_URL.
GROQ_API_KEY=

# OpenAI-compatible audio transcription endpoint used by the speech pipelines.
GROQ_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions

# Transcription model ID sent to GROQ_STT_URL; verify availability with your provider.
STT_MODEL=whisper-large-v3

# Legacy fallback used only when STT_MODEL is absent.
# GROQ_STT_MODEL=

# Vocabulary/context hint sent with audio transcription requests.
STT_PROMPT='Transcribe the caller accurately, preserving names and numbers.'

# Configured TTS provider label; current PCM synthesis uses OPENAI_TTS_URL and OPENAI_API_KEY.
TTS_PROVIDER=openai

# Speech endpoint expected to return raw 24 kHz mono signed 16-bit PCM.
OPENAI_TTS_URL=https://api.openai.com/v1/audio/speech

# Primary speech-synthesis model ID at OPENAI_TTS_URL.
TTS_MODEL=replace-with-your-speech-model

# Optional fallback synthesis model; keep the key present but blank to disable fallback.
TTS_FALLBACK_MODEL=

# Voice ID supported by the selected speech model.
TTS_VOICE=replace-with-your-voice

# Reserved secret in shared config; the current speech worker does not select an ElevenLabs adapter from this key.
# ELEVENLABS_API_KEY=

# Reserved secret for tone analysis; the present tone-analysis worker is a placeholder.
# TONE_MODEL_API_KEY=

# Initial spoken greeting for a new call; omit or leave empty to skip it.
AI_GREETING='Hello. How can I help you today?'

# Speech-model probability threshold for detecting caller speech (0 to 1).
VAD_SPEECH_PROBABILITY_THRESHOLD=0.005

# Speech-model probability threshold for interrupting assistant playback (0 to 1).
VAD_BARGE_IN_PROBABILITY_THRESHOLD=0.20

# Minimum PCM amplitude considered speech; also used by the phone voice-activity detector.
VAD_MIN_SPEECH_AMPLITUDE=100

# PCM amplitude at which strong speech can bypass the normal VAD probability gate.
VAD_ENERGY_BYPASS_AMPLITUDE=1000

# PCM amplitude needed for barge-in detection while the assistant speaks.
VAD_BARGE_IN_AMPLITUDE=100
VAD_BARGE_IN_MIN_CHUNKS=3
STS_TEXT_JITTER_MS=300
STS_TEXT_MAX_WAIT_MS=1800
GRAPH_CONTEXT_REQUEST_TIMEOUT_MS=500
ORCHESTRATOR_TOOL_TIMEOUT_MS=15000
ORCHESTRATOR_TOOL_MAX_RETRIES=3
ORCHESTRATOR_RETRY_BASE_MS=1000
ORCHESTRATOR_TASK_LEASE_MS=30000
STS_CONTEXT_UPDATE_ACK=I've gathered a bit more context. Give me a moment while I put that together.
DEEPFILTERNET_ENABLED=false
DEEPFILTERNET_BIN=deep-filter
DEEPFILTERNET_VERSION=0.5.6
# Optional DeepFilterNet model tar.gz; empty uses the binary's default model.
DEEPFILTERNET_MODEL=
DEEPFILTERNET_TIMEOUT_MS=2500

# Silence duration ending an utterance; supported range is 200 to 3000 milliseconds.
VAD_END_OF_SPEECH_TIMEOUT_MS=650

# ========================================================================
# Private call recordings (Cloudflare R2 / S3-compatible)
# ========================================================================
# Bucket storing conversation audio and related recording artifacts.
R2_BUCKET_NAME=your-private-recordings-bucket

# Cloudflare account ID identifying the R2 endpoint.
R2_ACCOUNT_ID=

# R2/S3 access key ID for recording storage; supply only in the relevant service's private .env.
R2_ACCESS_KEY_ID=

# Secret R2/S3 signing credential for recording upload and authorized access.
R2_SECRET_ACCESS_KEY=

# R2 endpoint for the configured account; replace the placeholder account ID.
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Maximum in-memory recording buffer per call, in bytes; must be greater than zero.
RECORDING_MAX_BUFFER_BYTES=33554432

# ========================================================================
# Telephony provider selection (backend)
# ========================================================================
# Enable exactly one of twilio, telnyx, vonage, plivo, sip or custom; disabled rejects all provider callbacks.
TELEPHONY_PROVIDER=disabled

# Public HTTPS backend origin used for webhook signature verification and provider media URLs.
TELEPHONY_PUBLIC_BASE_URL=https://your-backend.example.com

# Secret signing key for short-lived per-call media capabilities; also authenticates SIP/custom gateway callbacks.
TELEPHONY_WEBHOOK_SECRET=

# Twilio account identifier; required when TELEPHONY_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=

# Secret Twilio auth token used to verify incoming webhook signatures.
TWILIO_AUTH_TOKEN=

# Secret Telnyx API credential used to answer calls and request bidirectional media streaming.
TELNYX_API_KEY=

# Telnyx Voice API application/connection identifier; required by the Telnyx configuration readiness check.
TELNYX_CONNECTION_ID=

# Base64 Telnyx webhook verification public key used to validate Ed25519 signatures; not an API secret.
TELNYX_PUBLIC_KEY=

# Vonage account API identifier checked against signed webhook JWT claims.
VONAGE_API_KEY=

# Secret Vonage signed-webhook key; distinct from VONAGE_API_SECRET.
VONAGE_SIGNATURE_SECRET=

# Reserved Vonage API credential in shared config; the current inbound adapter authenticates with VONAGE_SIGNATURE_SECRET instead.
# VONAGE_API_SECRET=

# Plivo account identifier; required when TELEPHONY_PROVIDER=plivo.
PLIVO_AUTH_ID=

# Secret Plivo auth token used to verify v3 webhook signatures.
PLIVO_AUTH_TOKEN=

# External SIP gateway endpoint/configuration marker. The gateway must implement the README HTTP/WebSocket contract; this server is not a SIP registrar.
SIP_GATEWAY_URL=

# Reserved SIP gateway username; the current inbound bridge does not use it for SIP registration.
# SIP_USERNAME=

# Reserved secret SIP gateway password; inbound HTTP authentication uses TELEPHONY_WEBHOOK_SECRET.
# SIP_PASSWORD=

# Custom gateway endpoint/configuration marker; the gateway must implement the documented HTTP/WebSocket media contract.
CUSTOM_TELEPHONY_INGRESS_URL=

# Reserved secret for custom-provider integrations; current inbound gateway requests use TELEPHONY_WEBHOOK_SECRET.
# CUSTOM_TELEPHONY_API_KEY=

# ========================================================================
# Domain behavior, prompts and user-facing messages
# ========================================================================
# Domain name inserted into agent prompts.
APP_DOMAIN_NAME='Real Estate'

# Currency label used in property answers and chat templates.
APP_CURRENCY=AED

# Verification document name inserted into booking guidance.
KYC_DOCUMENT_NAME='Emirates ID'

# Require verified identity before booking; accepts true/1 to enable.
KYC_REQUIRED_FOR_BOOKING=true

# Message shown when verification is missing; {document_name} is replaced at runtime.
KYC_UNVERIFIED_MESSAGE='Please verify your {document_name} before booking.'

# Fallback response when available domain data cannot answer a question.
DOMAIN_FALLBACK_MESSAGE='That information is not available in the retrieved property details.'

# Primary property transaction type used for purchase intent.
FILTER_PRIMARY_TYPE_A=buy

# Primary property transaction type used for rental intent.
FILTER_PRIMARY_TYPE_B=rent

# Comma-separated words mapped to the purchase filter.
FILTER_TYPE_A_SYNONYMS=buy,sale,purchase,acquire

# Comma-separated words mapped to the rental filter.
FILTER_TYPE_B_SYNONYMS=rent,lease,leasing,annual

# Comma-separated words activating the pet-friendly feature filter.
FILTER_FEATURE_1_SYNONYMS=pet,dog,cat,animal

# Comma-separated words activating the transport-access feature filter.
FILTER_FEATURE_2_SYNONYMS=metro,commute,station,subway,train,transit

# Comma-separated words indicating a booking request.
ACTION_BOOKING_KEYWORDS=book,reserve,schedule,viewing,slot,appointment
CONTEXTUAL_FOLLOW_UP_PHRASES=yes,no,yeah,yep,nope,is it true,is that true,is this true,correct
CONTEXTUAL_FOLLOW_UP_CLARIFICATION='Please clarify what you mean about __PROPERTY_TITLE__: the price, availability, location, or another detail?'

# Base instruction for the conversational agent; customize for this deployment.
AGENT_SYSTEM_PROMPT='Help callers using verified property information. Do not invent facts. Resolve short follow-ups such as yes, no, is it available, how much, and how long from the most recent connected turn and cached property context before requesting a new tool call. An AssistantInterrupted graph event means the caller did not hear the rest of the prior response.'

# Chat prompt template; these four __PLACEHOLDER__ tokens are substituted by the server.
AGENT_CONTEXT_PROMPT_TEMPLATE='__SYSTEM_PROMPT__ Domain: __DOMAIN__. Currency: __CURRENCY__. Retrieved information: __CONTEXT__'

# Property follow-up prompt template; preserve the supported substitution tokens.
AGENT_EDGE_PROMPT_TEMPLATE='__SYSTEM_PROMPT__ Property: __PROPERTY_CONTEXT__. Unrelated questions: __UNRELATED_QUERY_MESSAGE__'
AGENT_TURN_PLANNER_PROMPT_TEMPLATE='__SYSTEM_PROMPT__ Return strict JSON only: {"action":"clarify"|"context"|"tool"|"wait","message":"...","tool_query":"...","depends_on_query_id":"...","depends_on_query_ids":["..."]}. Resolve confirmation and prior-reference context from __GRAPH_CONTEXT__; confirmation tool calls use tool_query, never literal yes/no. Use dependencies only for related pending results needed for __USER_QUESTION__.'
AGENT_TURN_ROUTER_PROMPT_TEMPLATE='Return JSON {"mode":"confirmation"|"reference"|"dependency"|"general"} from graph __GRAPH_CONTEXT__ and user __USER_QUESTION__.'
AGENT_CONFIRMATION_PLANNER_PROMPT_TEMPLATE='Resolve confirmation using graph __GRAPH_CONTEXT__; return tool_query for the confirmed original request, not yes/no.'
AGENT_REFERENCE_PLANNER_PROMPT_TEMPLATE='Resolve prior-discussion reference from graph __GRAPH_CONTEXT__; return context, tool with tool_query, or clarify.'
AGENT_DEPENDENCY_PLANNER_PROMPT_TEMPLATE='Choose exact pending query dependencies from graph __GRAPH_CONTEXT__; never invent IDs.'
AGENT_TOOL_RESULT_PROMPT_TEMPLATE='__SYSTEM_PROMPT__ Answer exact question __USER_QUESTION__ from __TOOL_RESULT__ and graph __GRAPH_CONTEXT__. Treat relations as authoritative: verified_result_for=facts, resolves_intent_for=request, follows_or_refines=active branch, answers_or_suggests_for=confirmation. Do not repeat unrelated data.'
AGENT_GRAPH_ENRICHMENT_PROMPT_TEMPLATE='Return strict JSON only for the actor-owned session-memory proposal: {"schema_version":1,"topic_summary":"..."|null,"active_entity_id":"..."|null,"active_entity_ids":["..."],"ordinal_map":{"first":"entity-id"},"follow_up_aliases":{"it":"entity-id"},"referenced_node_ids":["graph-node-id"],"unresolved_intent":"..."|null}. Derive this only from question __USER_QUESTION__, graph __GRAPH_CONTEXT__, and answer __ASSISTANT_RESPONSE__. Use only IDs present in the graph; never generate caller-facing speech or invent facts.'

# Response for unrelated questions when no relevant retrieval evidence exists.
UNRELATED_QUERY_MESSAGE='I can help with property questions. What would you like to know?'

# Property match response; title, location, price and currency placeholders are replaced.
PROPERTY_MATCH_MESSAGE_TEMPLATE='I found {title} in {location} for {price} {currency}.'

# Success message returned by property retrieval/tool execution.
RAG_SEARCH_SUCCESS_MESSAGE='I found relevant property information for you.'

# Response used when a requested contract cannot be found.
CONTRACT_NOT_FOUND_MESSAGE='I could not find that contract.'

# ========================================================================
# Web process only (public values are bundled into the browser)
# ========================================================================
# Next.js API rewrite destination; Compose overrides it with http://backend:4000.
BACKEND_URL=http://127.0.0.1:4000

# Public browser LiveKit endpoint. Set before the Next.js build; never put API secrets in NEXT_PUBLIC keys.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.example.com

# Public Google OAuth client ID embedded at web build time; must match backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ========================================================================
# Legacy/documentation-only names (not active runtime configuration)
# ========================================================================
# Not read by the current server; use PORT instead.
# SERVER_PORT=

# Not read by the current speech pipeline; use GROQ_STT_URL instead.
# STT_ENDPOINT_URL=

# Not read by the current speech pipeline; use OPENAI_TTS_URL instead.
# TTS_ENDPOINT_URL=

# Not read by the current runtime; configure LLM_API_KEY and DECISION_LLM_API_KEY as needed.
# STS_LLM_API_KEY=

# Optional external Neo4j Aura inventory metadata; not read by this application.
# AURA_INSTANCEID=

# Optional external Neo4j Aura display metadata; not read by this application.
# AURA_INSTANCENAME=

# Appears only in a displayed UI code snippet; not an application runtime credential.
# DWIN_API_KEY=


# Optional headless control-plane DNS host:port. When set, connect to EVERY resolved pod.
# Leave unset outside Kubernetes to use CONTROL_PLANE_ENDPOINT directly.
# CONTROL_PLANE_DISCOVERY_ADDR=voice-control-plane-headless.default.svc.cluster.local:50051
# Cell-only Prometheus listener. Keep this port internal to the cluster.
CELL_METRICS_PORT=9091
# Kubernetes injects the cell pod name. Outside Kubernetes HOSTNAME is the fallback.
# POD_NAME=voice-backend-local

# Instructions for the summary worker. Empty means no additional system context.
SUMMARY_SYSTEM_PROMPT=
