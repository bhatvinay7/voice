# Copy these settings into .env; keep the rest of your configuration unchanged.
# Select exactly one: disabled, twilio, telnyx, vonage, plivo, sip, custom.
TELEPHONY_PROVIDER=disabled
TELEPHONY_PUBLIC_BASE_URL=https://your-backend.example.com
# Generate a random secret for short-lived media capabilities (and gateway webhooks).
TELEPHONY_WEBHOOK_SECRET=

# Twilio: configure the number's incoming voice webhook to use HTTP POST.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telnyx: use a Voice API application, its connection ID, and webhook public key.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# Vonage: enable signed webhooks and set answer/event webhook methods to POST.
VONAGE_API_KEY=
VONAGE_SIGNATURE_SECRET=

# Plivo: configure the number's answer/event webhook to use HTTP POST.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# SIP and custom providers require a gateway implementing the documented
# signed HTTP + PCM WebSocket contract. This server is not a SIP registrar.
SIP_GATEWAY_URL=
CUSTOM_TELEPHONY_INGRESS_URL=
